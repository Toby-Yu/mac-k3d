# Tool versions every eval host runs. One file for both sides:
#   pipeline/stages/_common.sh reads it at the start of every step, and
#   mac-k3d compiles it in (src/prepare/toolchain.rs) so `setup` installs the
#   same Harbor the pipeline asserts. A job or caller env var still wins.
# KEY=value lines only; the file is parsed, never sourced as shell.
HARBOR_VERSION=0.22.0
DOCKER_COMPOSE_VERSION=v2.40.3
DOCKER_BUILDX_VERSION=v0.29.1
